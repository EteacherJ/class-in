{
  "name": "class-in",
  "version": "1.1.56",
  "description": "Class in - 스마트 학급 대시보드",
  "author": "Smart Classroom OS",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "node run-dashboard.mjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "app": "vite --port=3000 --open",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron": "electron electron/main.js",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k -s first \"npm run dev\" \"electron .\"",
    "version:bump": "npm version patch --no-git-tag-version",
    "build:mac": "node scripts/build-mac.mjs",
    "build:win": "vite build && electron-builder --win --x64",
    "build:win:x64": "vite build && electron-builder --win --x64",
    "preview:app": "vite build && cross-env CLASSIN_PREVIEW=1 electron ."
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@types/qrcode": "^1.5.5",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "electron": "^44.10.2",
    "electron-builder": "^25.1.8",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.classin.app",
    "productName": "Class in",
    "icon": "build/icon.png",
    "electronVersion": "44.10.2",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EteacherJ",
        "repo": "class-in",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.cjs",
      "electron/securityGuards.js",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "소음 측정 위젯에서 교실 소리 크기를 측정하기 위해 마이크를 사용합니다."
      },
      "artifactName": "Class-in-${version}-mac-arm64.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Class-in-Setup-${version}-win-x64.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Class in",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "warningsAsErrors": false,
      "artifactName": "Class-in-Setup-${version}-win-x64.${ext}",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "unicode": true
    },
    "copyright": "Copyright © 2026 Class in",
    "dmg": {
      "title": "Class in ${version}",
      "artifactName": "Class-in-${version}-mac-arm64.${ext}"
    }
  },
  "productName": "Class in"
}
